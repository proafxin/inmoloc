{
  "repeats": 1,

  "targets": [
    { "name": "llamacpp", "kind": "llamacpp", "image": "ghcr.io/ggml-org/llama.cpp:server-cuda" },
    { "name": "llamacpp-12", "kind": "llamacpp", "image": "ghcr.io/ggml-org/llama.cpp:server-cuda", "args": "-c 12288 --parallel 12" },
    { "name": "elastic20", "kind": "inmoloc", "image": "inmoloc:elastic20", "args": "--rs-rollback replay --max-output-tokens 512" },
    { "name": "current", "kind": "inmoloc", "image": "inmoloc:latest", "args": "--rs-rollback replay --max-output-tokens 512" }
  ],

  "compare": [["current", "elastic20"], ["elastic20", "llamacpp-12"], ["elastic20", "llamacpp"]],

  "engine": {
    "bench":   { "n_prompt": "512", "n_gen": "128", "repetitions": 3 },
    "batched": { "npp": "512", "ntg": "64", "npl": "1,8,32" }
  },

  "workloads": {
    "generate": { "prompt_tokens": 64 },
    "mixed":    { "prompt_tokens": "64-2048" },
    "short":    { "prompt_tokens": 256 },
    "long-in":  { "prompt_tokens": 4096 }
  },

  "models": [
    {
      "name": "qwen3.8-mtp",
      "file": "Qwen3.8-27B-AP-Q4_K_XL.gguf",
      "tiers": ["engine", "server"],
      "engine_args": "-fa on -ctk q8_0 -ctv q8_0",
      "engine_ctx": 20480,
      "common_args": "-fa on --cache-type-k q8_0 --cache-type-v q8_0 --spec-type draft-mtp --spec-draft-n-max 2 --cache-ram 0",
      "llamacpp_args": "-c 65536 --parallel 8 --n-predict 512",
      "inmoloc_args": "--vram-budget 22826M",
      "workloads": ["mixed"],
      "levels": [1, 2, 4, 8, 16, 32, 64]
    },
    {
      "name": "gemma4-e4b",
      "file": "Nemotron-3.5-Bolt-E4B-Q4_K_M.gguf",
      "tiers": ["engine", "server"],
      "engine_args": "-fa on -ctk q8_0 -ctv q8_0",
      "engine_ctx": 20480,
      "common_args": "-fa on --cache-type-k q8_0 --cache-type-v q8_0 --cache-ram 0",
      "llamacpp_args": "-c 131072 --parallel 16",
      "inmoloc_args": "--vram-budget 20G",
      "workloads": ["mixed"],
      "levels": [1, 2, 4, 8, 32, 64, 128]
    },
    {
      "name": "qwen3.8",
      "default": false,
      "file": "Qwen3.8-27B-AP-Q4_K_XL.gguf",
      "tiers": ["server"],
      "common_args": "-fa on --cache-type-k q8_0 --cache-type-v q8_0 --cache-ram 0",
      "llamacpp_args": "-c 65536 --parallel 8",
      "inmoloc_args": "--vram-budget 20G",
      "workloads": ["mixed"],
      "levels": [128]
    },
    {
      "name": "harrier-embed",
      "default": false,
      "file": "harrier-oss-v1-0.6b-BF16.gguf",
      "tiers": ["embed"],
      "common_args": "--embedding --pooling mean -fa on --cache-ram 0",
      "llamacpp_args": "-c 32768 --parallel 16 -ub 2048 -b 2048",
      "inmoloc_args": "--vram-budget 8G -ub 2048 -b 2048",
      "embed": { "n_requests": 256, "min_words": 20, "max_words": 1200 },
      "levels": [128]
    },
    {
      "name": "paddleocr-vl",
      "default": false,
      "file": "PaddleOCR-VL-1.6/PaddleOCR-VL-1.6-Q8_0.gguf",
      "tiers": ["vision"],
      "common_args": "--mmproj /models/PaddleOCR-VL-1.6/PaddleOCR-VL-1.6-GGUF-mmproj.gguf --chat-template-file /models/PaddleOCR-VL-1.6/chat_template.jinja --cache-type-k bf16 --cache-type-v bf16 -fa on --cache-ram 0",
      "llamacpp_args": "-c 184320 --parallel 45",
      "inmoloc_args": "--vram-budget 5G",
      "vision": { "images": "", "n_requests": 256, "prompt": "OCR:" },
      "levels": [128]
    }
  ]
}
